      <field><name>AREA_KM2</name><type>String</type></field>
      <field><name>v0001</name><type>Integer</type></field>
      <field><name>total_casos_dengue</name><type>Integer</type></field>
    </fields>
    <GUI><xloc>860</xloc><yloc>180</yloc></GUI>
  </transform>
</pipeline>