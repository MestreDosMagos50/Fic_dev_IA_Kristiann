    <GUI><xloc>140</xloc><yloc>120</yloc></GUI>
  </transform>
  <transform>
    <name>Ajusta Chave IBGE (6 digitos)</name>
    <type>StringCut</type>
    <fields>
      <field>
        <in_stream_name>CD_MUN</in_stream_name>
        <out_stream_name>cod_mun_6</out_stream_name>
        <cut_from>0</cut_from>
        <cut_to>6</cut_to>
      </field>
    </fields>
    <GUI><xloc>380</xloc><yloc>120</yloc></GUI>
  </transform>
