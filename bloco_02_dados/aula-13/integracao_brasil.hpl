    <from>Agrupa Notificacoes Dengue</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <lookup>
      <key>
        <name>cod_mun_6</name>
        <field>ID_MN_RESI</field>
      </key>
      <value>
        <name>total_casos_dengue</name>
        <rename>total_casos_dengue</rename>
        <default>0</default>
        <type>Integer</type>
