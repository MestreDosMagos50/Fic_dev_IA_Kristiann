# Configuração de Acesso ao Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=superset_user
DB_PASSWORD=superset_password
DB_NAME=superset_data

# Intervalo de Sincronização em Segundos (300 = 5 minutos)
UPDATE_INTERVAL_SECONDS=300

# URL do Apache Superset
SUPERSET_URL=http://localhost:8088
