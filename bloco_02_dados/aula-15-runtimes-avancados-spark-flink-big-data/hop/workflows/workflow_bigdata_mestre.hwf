<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>workflow_bigdata_mestre</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Workflow Mestre de Orquestracao Big Data - Verificacao, Conversao Parquet, Agregacao e Particionamento</description>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>60</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Check: CSV de Entrada Existe?</name>
      <type>FILE_EXISTS</type>
      <filename>${PROJECT_HOME}/dados/entrada/vendas_grandes.csv</filename>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>220</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Shell: Gera Vendas se Ausente</name>
      <type>SHELL</type>
      <work_directory>${PROJECT_HOME}</work_directory>
      <filename>${PROJECT_HOME}/scripts/gera_vendas_grandes.py</filename>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>/home/ficdevia-16-tarde/miniconda3/bin/python3 ${PROJECT_HOME}/scripts/gera_vendas_grandes.py --linhas 1000000</script>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>220</xloc>
      <yloc>280</yloc>
    </action>
    <action>
      <name>Pipeline: Converte CSV para Parquet</name>
      <type>PIPELINE</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/hop/pipelines/converte_parquet.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>440</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Pipeline: Agrega Vendas Parquet</name>
      <type>PIPELINE</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/hop/pipelines/agrega_vendas_parquet.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>680</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Shell: Responde Desafios e Particiona Mes</name>
      <type>SHELL</type>
      <work_directory>${PROJECT_HOME}</work_directory>
      <filename/>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>/home/ficdevia-16-tarde/miniconda3/bin/python3 ${PROJECT_HOME}/scripts/responder_desafios_negocio.py</script>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>920</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Log: Sucesso na Orquestracao</name>
      <type>WRITE_TO_LOG</type>
      <loglevel>Basic</loglevel>
      <logmessage>🎉 WORKFLOW BIG DATA FINALIZADO COM SUCESSO! Parquet gerado, analises concluidas e particionamento Hive criado.</logmessage>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>1120</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>1260</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Log: Erro Convergente</name>
      <type>WRITE_TO_LOG</type>
      <loglevel>Error</loglevel>
      <logmessage>❌ FALHA CRITICA NA ORQUESTRACAO DO WORKFLOW BIG DATA! Verifique os logs das etapas anteriores.</logmessage>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>680</xloc>
      <yloc>300</yloc>
    </action>
    <action>
      <name>Abort Workflow</name>
      <type>ABORT</type>
      <parallel>N</parallel>
      <nr>0</nr>
      <xloc>920</xloc>
      <yloc>300</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Check: CSV de Entrada Existe?</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Check: CSV de Entrada Existe?</from>
      <to>Pipeline: Converte CSV para Parquet</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check: CSV de Entrada Existe?</from>
      <to>Shell: Gera Vendas se Ausente</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Shell: Gera Vendas se Ausente</from>
      <to>Pipeline: Converte CSV para Parquet</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Pipeline: Converte CSV para Parquet</from>
      <to>Pipeline: Agrega Vendas Parquet</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Pipeline: Agrega Vendas Parquet</from>
      <to>Shell: Responde Desafios e Particiona Mes</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Shell: Responde Desafios e Particiona Mes</from>
      <to>Log: Sucesso na Orquestracao</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Log: Sucesso na Orquestracao</from>
      <to>Success</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Pipeline: Converte CSV para Parquet</from>
      <to>Log: Erro Convergente</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Pipeline: Agrega Vendas Parquet</from>
      <to>Log: Erro Convergente</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Shell: Responde Desafios e Particiona Mes</from>
      <to>Log: Erro Convergente</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Log: Erro Convergente</from>
      <to>Abort Workflow</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
  </hops>
</workflow>
